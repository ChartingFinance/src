# fixture: social-security-dated-before-62  (adversarial)
#
# SOCIAL_SECURITY_DEFERRED: a benefit dated before 62 is held until January
# of the year the household turns 62, and the deferral is recorded in the
# month it was dated. No real profile reaches it: quick start never dates a
# benefit before 62. The household is 60 in 2026, so 2028 is the first
# claimable year, and the plan runs on to show the first payment. The
# pension dated in the same month pays from the start: the rule is Social
# Security's alone. Checking covers the two years without it, so nothing
# goes unpaid.

[config]
  allocateHouseholdTax = false
  backtestYear = current
  filingAs = Single
  inflationRate = 0.031
  pensionWithholdingRate = 0.1
  propertyTaxDeductionMax = 40000
  simDataMode = calibrated
  socialSecurityWithholdingRate = 0
  userFinishAge = 87
  userRetirementAge = 60
  userStartAge = 60
  homeSaleExclusion = 250000
  retirementWithholdingRate = 0.1

