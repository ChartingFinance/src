# fixture: mfj-two-earners  (adversarial)
#
# TWO working-income assets, each earning above the Social Security wage
# base. TaxTable keys its accumulator by TaxOwner but ships with exactly ONE
# owner, and payroll-engine passes PRIMARY for every income asset, so both
# salaries share a single $184,500 base and the second earner stops paying
# SS tax early. No other fixture has more than one working income, which is
# why the whole corpus reported identical socialSecurityTax under MFJ — the
# branch was unreachable, not correct.

[config]
  backtestYear = current
  filingAs = MFJ
  inflationRate = 0.031
  propertyTaxDeductionMax = 40000
  simDataMode = calibrated
  userFinishAge = 87
  userRetirementAge = 67
  userStartAge = 45
  allocateHouseholdTax = false
  homeSaleExclusion = 500000
  pensionWithholdingRate = 0.1
  socialSecurityWithholdingRate = 0
  retirementWithholdingRate = 0.1

[totals]
  months = 240
  firstDate = 2026-01
  lastDate = 2030-12
  startValue = 20000.000000
  finishValue = 1106006.353375
  accumulated = 0.000000
  total.employedIncome = 2160000.000000
