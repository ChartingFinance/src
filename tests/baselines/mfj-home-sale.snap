# fixture: mfj-home-sale  (adversarial)
#
# the primary-home capital-gains exclusion, sized to the window where filing
# status is the whole answer. The home closes after more than 24 months with
# a gain of roughly $400k: single excludes $250k and taxes the rest, MFJ
# excludes $500k and taxes nothing. Today the exclusion is the hardcoded
# global_home_sale_capital_gains_discount = 250000 with no filing check
# (taxes.js), so THIS BASELINE IS EXPECTED TO BE WRONG when first recorded.
# It exists so spec 5 step 2 has something that must move; a gain outside
# that $250k-$500k window would leave step 2 with an empty diff and no
# proof.

[config]
  backtestYear = current
  equityDividendAllocation = 0.5
  equityDividendAverageAnnualRate = 0.025
  equityGrowthAllocation = 0.5
  filingAs = MFJ
  inflationRate = 0.031
  propertyTaxDeductionMax = 40000
  propertyTaxRate = 0.01
  simDataMode = calibrated
  taxYear = 2025
  userFinishAge = 87
  userRetirementAge = 67
  userStartAge = 55
  allocateHouseholdTax = false
  homeSaleExclusion = 500000
  pensionWithholdingRate = 0.1
  socialSecurityWithholdingRate = 0
  retirementWithholdingRate = 0.1

