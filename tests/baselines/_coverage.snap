# EventType coverage across the whole corpus.
#
# A type listed under NEVER EMITTED is a branch no fixture reaches — every
# assertion about it is currently vacuous, and it can be deleted or inverted
# with the suite green. That has happened here repeatedly, so the gap is
# recorded rather than assumed. Shrinking this list is a good PR on its own;
# growing it means a fixture stopped reaching something it used to.

[emitted]
  assetGrowth
  capitalGainExcluded
  capitalGainRecognized
  capitalGainsTax
  contributionCapped
  dividend
  expenseInflation
  ficaWithholding
  grossUp
  incomeGrowth
  incomeTaxWithholding
  insurance
  interestIncome
  maintenance
  mortgageInterest
  mortgagePrincipal
  oneTime
  propertyTax
  propertyTaxEscrow
  settlement
  spillover
  taxTrueUp
  transfer
  unfunded

[never emitted]
  (none — every declared EventType is reached)

