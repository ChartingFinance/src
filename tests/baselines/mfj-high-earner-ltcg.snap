# fixture: mfj-high-earner-ltcg  (adversarial)
#
# capitalGainsTax UNDER MFJ. The married 0% LTCG bracket is $98,900 against
# single's $49,450, and quickstart-earlyCareer is the only fixture in the
# corpus that emits capitalGainsTax at all — so switching it to MFJ drops
# the type out of [emitted] entirely and every assertion about capital-gains
# tax becomes vacuous with the suite green. Found by this tool's own
# coverage report, not by guessing. Two things had to be true, and the first
# draft got both wrong. CAPITAL_GAINS_TAX is emitted only on CLOSE
# (tax-engine reads finishCurrency − finishBasisCurrency), not on ongoing
# withdrawals, so the brokerage must survive to its close date rather than
# being drained by an expense — a draft that funded a large expense from it
# closed at ~$0 gain and emitted nothing. And the tax is computed against
# annualised income at the moment of close, so the brokerage closes in 2029
# while the salary is still running; closing it in the final month would
# price the gain against almost no income (the known close-time-LTCG gap,
# review 2026-07-25) and the doubled 0% bracket would swallow it again.

[config]
  backtestYear = current
  equityDividendAllocation = 0.5
  equityDividendAverageAnnualRate = 0.025
  equityGrowthAllocation = 0.5
  filingAs = MFJ
  inflationRate = 0.031
  propertyTaxDeductionMax = 40000
  propertyTaxRate = 0.01
  simDataMode = calibrated
  taxYear = 2025
  userFinishAge = 87
  userRetirementAge = 67
  userStartAge = 55
  allocateHouseholdTax = false
  homeSaleExclusion = 500000
  pensionWithholdingRate = 0.1
  socialSecurityWithholdingRate = 0
  retirementWithholdingRate = 0.1

