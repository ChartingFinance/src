# fixture: aca-early-retiree-single  (adversarial)
#
# the ACA premium tax credit (spec 11 Part A) for a single early retiree
# living on IRA draws. No estimated income and no year before the plan, so
# 2026 advances nothing and the whole credit is paid on the return: the
# positive ptcReconciliation no other fixture reaches. From 2027 the advance
# is paid on the year before, and as income creeps up the advance runs ahead
# of the credit and is repaid. The premium steps each January at 8%, above
# plan inflation.

[config]
  allocateHouseholdTax = false
  backtestYear = current
  filingAs = Single
  inflationRate = 0.031
  pensionWithholdingRate = 0.1
  propertyTaxDeductionMax = 40000
  simDataMode = calibrated
  socialSecurityWithholdingRate = 0
  userFinishAge = 87
  userRetirementAge = 60
  userStartAge = 60
  homeSaleExclusion = 250000
  retirementWithholdingRate = 0.1

