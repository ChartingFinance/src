# Snapshot baselines are compared byte-for-byte against text the tool generates
# fresh, which always uses LF. This repo is used with core.autocrlf=true, which
# would rewrite them to CRLF on checkout — and every fixture would then report
# drift on a clean clone, with no engine change behind it.
#
# tests/tools/snapshot.mjs also normalises line endings when it reads a
# baseline, so a stray CRLF cannot break the check. This attribute is the fix;
# that normalisation is the seatbelt.
tests/baselines/*.snap text eol=lf
tests/baselines/README.md text eol=lf

# Collapse the baselines in GitHub's diff view, and keep them out of the
# repository's language statistics.
#
# They are generated — `node tests/tools/snapshot.mjs --bless` reproduces every
# byte deterministically — and they are large: about 85% of the corpus is the
# per-event listing, so one 55-year quick-start profile is over 20,000 lines. A
# PR that adds a profile was reading as 46,000 additions against 250 lines of
# actual change, which buries the review.
#
# This only affects how GitHub PRESENTS them. `git diff tests/baselines/` is
# untouched, which matters: the committed baselines exist so that a behavioural
# change is reviewable as text and "nothing moved" is an empty diff rather than
# a claim. Do NOT reach for `-diff` or `binary` here — that would take the diff
# away locally too, and the diff is the entire point of committing them.
tests/baselines/*.snap linguist-generated=true

# The plugin bundle is generated and committed, and tests/plugin-bundle-fresh.mjs
# compares it against a fresh build. Same reasoning as the baselines above: with
# core.autocrlf=true a clean clone would rewrite it to CRLF and the freshness
# check would report drift with no engine change behind it. The test normalises
# line endings too — this attribute is the fix, that normalisation is the
# seatbelt.
plugin/server/mcp-server.mjs text eol=lf

# Collapse it in GitHub's diff view and keep it out of language statistics. It
# is 39,000 lines of generated output; a one-line engine change reads as a
# whole-file rewrite otherwise, which buries the actual review.
plugin/server/mcp-server.mjs linguist-generated=true

# The manifest is generated by the same script — `tools/build-plugin.mjs`
# rewrites its `tools` list from a live tools/list — and it is read back by
# tests/plugin-bundle-fresh.mjs. Without this, a build in a CRLF checkout
# leaves it staged-dirty with an empty `git diff`, which is the same false
# drift the attribute above exists to prevent, one file over.
plugin/.claude-plugin/plugin.json text eol=lf
